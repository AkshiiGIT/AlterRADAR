{
  "name": "alterradar-desktop",
  "productName": "AlterRADAR",
  "version": "0.10.0",
  "description": "AlterRADAR : recherche automatique de stages et alternances, métiers déduits du CV, IA locale et validation Telegram",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Akasche MAHINTAN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "electron-builder --win nsis portable --x64 --arm64",
    "dist": "electron-builder",
    "check:public": "node scripts/check-public.cjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.1",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "fr.alterradar.desktop",
    "productName": "AlterRADAR",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*",
      "config/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "AlterRADAR-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Akasche MAHINTAN"
  }
}
