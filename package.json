{
  "name": "alterradar-desktop",
  "productName": "AlterRADAR",
  "version": "0.12.0",
  "description": "AlterRADAR : recherche locale de stages et alternances, matching de CV, IA Ollama et validation Telegram",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Akasche MAHINTAN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --arm64 --publish never",
    "dist": "electron-builder",
    "check:public": "node scripts/check-public.cjs",
    "verify:release": "npm run test && npm run check:lock && npm run smoke:deps && npm run check:public",
    "check:lock": "node scripts/verify-lock.cjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "smoke:deps": "node scripts/smoke-dependencies.cjs"
  },
  "dependencies": {
    "docx": "9.11.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.alterradar.desktop",
    "productName": "AlterRADAR",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*",
      "config/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "AlterRADAR-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Akasche MAHINTAN",
    "asarUnpack": [
      "**/node_modules/@napi-rs/**",
      "**/node_modules/pdf-parse/**/pdf.worker*.mjs"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  }
}
